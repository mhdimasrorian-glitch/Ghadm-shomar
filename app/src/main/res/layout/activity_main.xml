<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FB">

<ScrollView android:id="@+id/scrollRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/tabBar" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

    <!-- Header -->
    <LinearLayout android:orientation="horizontal" android:background="#F97316" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="بگردش" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/coinBadge" android:text="۰ سکه" android:textSize="16sp" android:textColor="#FFFFFF" android:background="#33FFFFFF" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- HOME SECTION -->
    <LinearLayout android:id="@+id/sectionHome" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/status" android:text="ورود با شماره موبایل" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/phone" android:hint="شماره موبایل" android:inputType="phone" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/code" android:hint="کد ۶ رقمی OTP" android:inputType="number" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/otp" android:text="دریافت کد ورود" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/steps" android:text="۰ قدم" android:textSize="40sp" android:textStyle="bold" android:gravity="center" android:padding="28dp" android:layout_marginTop="18dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/todayCoins" android:text="امروز: ۰ سکه کسب شده" android:textSize="15sp" android:gravity="center" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/sync" android:text="خواندن و همگام‌سازی قدم‌ها" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="جایزه روزانه" android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:background="#FFFFFF" android:padding="16dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/dailyRewardText" android:text="جایزه امروزت رو دریافت نکردی" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical"/>
            <Button android:id="@+id/claimDaily" android:text="دریافت" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- CHALLENGES SECTION -->
    <LinearLayout android:id="@+id/sectionChallenges" android:orientation="vertical" android:padding="18dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="چالش‌های فعال" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/challengesList" android:orientation="vertical" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- STORE SECTION -->
    <LinearLayout android:id="@+id/sectionStore" android:orientation="vertical" android:padding="18dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="فروشگاه جوایز" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/storeList" android:orientation="vertical" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- REFERRAL SECTION -->
    <LinearLayout android:id="@+id/sectionReferral" android:orientation="vertical" android:padding="18dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="دعوت از دوستان" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="به ازای هر دوست که با کد شما عضو شود، ۲۰۰ سکه جایزه می‌گیرید." android:textSize="14sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:background="#FFFFFF" android:padding="16dp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/referralCode" android:text="------" android:textSize="20sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/copyReferral" android:text="کپی" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/inviteCount" android:text="تعداد دعوت‌های موفق: ۰" android:textSize="14sp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="کد معرف دارید؟" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/referralInput" android:hint="کد معرف را وارد کنید" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/applyReferral" android:text="ثبت کد" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- WALLET / WITHDRAW SECTION -->
    <LinearLayout android:id="@+id/sectionWallet" android:orientation="vertical" android:padding="18dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="کیف پول" android:textSize="19sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/walletBalance" android:text="موجودی: ۰ ریال معادل" android:textSize="17sp" android:padding="18dp" android:background="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="برداشت وجه" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/withdrawAmount" android:hint="مبلغ برداشت (ریال)" android:inputType="number" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/sheba" android:hint="شماره شبا (IR...)" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/withdraw" android:text="درخواست برداشت" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="تاریخچه تراکنش‌ها" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/txHistory" android:orientation="vertical" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
</ScrollView>

<!-- BOTTOM TAB BAR -->
<LinearLayout android:id="@+id/tabBar" android:layout_alignParentBottom="true" android:orientation="horizontal" android:background="#FFFFFF" android:elevation="8dp" android:layout_width="match_parent" android:layout_height="60dp">
    <Button android:id="@+id/tabHome" android:text="خانه" android:background="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
    <Button android:id="@+id/tabChallenges" android:text="چالش‌ها" android:background="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
    <Button android:id="@+id/tabStore" android:text="فروشگاه" android:background="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
    <Button android:id="@+id/tabReferral" android:text="دعوت" android:background="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
    <Button android:id="@+id/tabWallet" android:text="کیف پول" android:background="@null" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
</LinearLayout>

</RelativeLayout>
