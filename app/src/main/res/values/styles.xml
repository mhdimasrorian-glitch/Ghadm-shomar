<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#F97316</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:editTextStyle">@style/AppEditText</item>
        <item name="android:windowBackground">#F5F7FB</item>
    </style>

    <style name="AppButton" parent="android:Widget.Material.Light.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AppEditText" parent="android:Widget.Material.Light.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">#1E293B</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
